# Supply-chain settings. min-release-age and allow-git need npm 11.10+,
# allow-remote 11.15+; older npm ignores them without a word, so
# package.json's engines requires npm 11.16+ and engine-strict enforces it.

# No dependency install scripts: the most common way a hijacked package
# runs code. The toolchain needs none (Rolldown, Oxc and Lightning CSS ship
# their binaries as platform packages). It also stops this package's own
# prepare script, so run `npm run prepare` once to install the git hooks.
ignore-scripts=true

# Don't take a version published less than 7 days ago (unit: days):
# hijacked releases are usually found and pulled within that time.
min-release-age=7

# Packages only from the npm registry: no git or tarball-URL dependencies.
# npm wrongly treats a registry tarball as "remote" when it opens one to read
# its bundleDependencies (npm/cli#9800), which @tailwindcss/oxide-wasm32-wasi
# has, so `npm install --package-lock-only` and `--dry-run` fail with
# EALLOWREMOTE. A plain `npm install` works; update the lockfile with that
# rather than loosening this.
allow-git=none
allow-remote=none

engine-strict=true
fund=false
