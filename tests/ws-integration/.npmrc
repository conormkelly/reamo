# Supply-chain settings, the same as frontend/.npmrc. min-release-age and
# allow-git need npm 11.10+, allow-remote 11.15+; older npm ignores them
# without a word, so package.json's engines requires npm 11.16+ and
# engine-strict enforces it.

# No dependency install scripts: the most common way a hijacked package
# runs code. The toolchain needs none (esbuild and rollup ship their
# binaries as platform packages).
ignore-scripts=true

# Don't take a version published less than 7 days ago (unit: days):
# hijacked releases are usually found and pulled within that time.
min-release-age=7

# Packages only from the npm registry: no git or tarball-URL dependencies.
allow-git=none
allow-remote=none

engine-strict=true
fund=false
